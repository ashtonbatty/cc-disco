FROM quay.io/centos/centos:stream9

# Two ansible-core controllers, matching the documented support matrix:
#   2.11 — the last release that manages Python 2.6 targets (EL6)
#   2.16 — EL7 (py2.7), EL8 (py3.6), EL9/EL10 and Ubuntu 24.04 (py3.12)
# ansible.windows is deliberately not installed: the run proves the playbook
# still parses without it (Windows tasks are included dynamically).
# The DEFAULT crypto policy is enough for CentOS 6: its host key and the login
# key are both ECDSA, so no SHA-1 (ssh-rsa) signatures are needed.
RUN dnf install -y python3 python3.11 python3.11-pip openssh-clients && \
    dnf clean all

# ansible-core 2.11 predates Jinja2 3.1 (contextfunction removal).
RUN python3 -m venv /opt/ansible-2.11 && \
    /opt/ansible-2.11/bin/pip install --no-cache-dir --upgrade pip && \
    /opt/ansible-2.11/bin/pip install --no-cache-dir 'ansible-core>=2.11,<2.12' 'jinja2>=3.0,<3.1' pyyaml && \
    python3.11 -m venv /opt/ansible-2.16 && \
    /opt/ansible-2.16/bin/pip install --no-cache-dir --upgrade pip && \
    /opt/ansible-2.16/bin/pip install --no-cache-dir 'ansible-core>=2.16,<2.17' pyyaml

# Create ansible user and pre-create the output volume mount point so the
# named volume is initialised with the correct ownership on first use.
RUN useradd -m ansible && \
    mkdir -p /home/ansible/playbook/output && \
    chown ansible:ansible /home/ansible/playbook/output
USER ansible
WORKDIR /home/ansible

# Copy SSH private key
RUN mkdir -p /home/ansible/.ssh && chmod 700 /home/ansible/.ssh
COPY --chown=ansible:ansible tests/integration/ssh-keys/id_ecdsa /home/ansible/.ssh/id_ecdsa
RUN chmod 600 /home/ansible/.ssh/id_ecdsa

# Disable strict host key checking for test containers.
RUN printf 'Host *\n  StrictHostKeyChecking no\n  UserKnownHostsFile /dev/null\n' \
    > /home/ansible/.ssh/config && chmod 600 /home/ansible/.ssh/config

# Copy playbook (full project tree, including tests/integration/inventory)
COPY --chown=ansible:ansible . /home/ansible/playbook/
WORKDIR /home/ansible/playbook

ENTRYPOINT ["/bin/bash", "/home/ansible/playbook/tests/integration/entrypoint.sh"]
