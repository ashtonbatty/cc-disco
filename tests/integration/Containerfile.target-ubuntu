FROM docker.io/library/ubuntu:24.04

ARG SCENARIO=ubuntu2404-inventory
ENV DEBIAN_FRONTEND=noninteractive

# sshd, sudo, python3-apt (needed by package_facts) and the tools the
# inventory layer probes (ps, ss). apt lists are kept: `apt list --upgradable`
# reads them.
RUN apt-get update && \
    apt-get install -y --no-install-recommends openssh-server sudo python3 python3-apt procps iproute2 && \
    mkdir -p /run/sshd

# Create ansible user with sudo
RUN useradd -m -s /bin/bash ansible && \
    echo "ansible ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/ansible && \
    chmod 0440 /etc/sudoers.d/ansible

# Configure sshd
RUN ssh-keygen -A && \
    sed -i 's/^#*PermitRootLogin.*/PermitRootLogin no/' /etc/ssh/sshd_config && \
    sed -i 's/^#*PubkeyAuthentication.*/PubkeyAuthentication yes/' /etc/ssh/sshd_config && \
    sed -i 's/^#*PasswordAuthentication.*/PasswordAuthentication no/' /etc/ssh/sshd_config && \
    # pam_loginuid fails in containers — make it optional
    sed -i 's/^\(session.*pam_loginuid.so\)$/session optional pam_loginuid.so/' /etc/pam.d/sshd

# Install SSH public key
RUN mkdir -p /home/ansible/.ssh && chmod 700 /home/ansible/.ssh
COPY tests/integration/ssh-keys/id_ecdsa.pub /home/ansible/.ssh/authorized_keys
RUN chmod 600 /home/ansible/.ssh/authorized_keys && \
    chown -R ansible:ansible /home/ansible/.ssh

# Provision script (scenario-specific config)
COPY tests/integration/scenarios/${SCENARIO}/provision.sh /tmp/provision.sh
RUN chmod +x /tmp/provision.sh && /tmp/provision.sh

CMD ["/usr/sbin/sshd", "-D"]
