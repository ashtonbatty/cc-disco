FROM centos:7

# CentOS 7 repos are archived. vault.centos.org now answers 403 to plain-HTTP
# yum, so use the kernel.org mirror of the vault.
RUN sed -i 's|^mirrorlist=|#mirrorlist=|g' /etc/yum.repos.d/CentOS-Base.repo && \
    sed -i 's|^#\s*baseurl=http://mirror.centos.org/centos/$releasever|baseurl=http://archive.kernel.org/centos-vault/7.9.2009|g' /etc/yum.repos.d/CentOS-Base.repo

# Install sshd and basic tools (ps and ss are probed by the inventory layer)
RUN yum install -y openssh-server sudo python2 procps-ng iproute && \
    yum clean all

# User, sudo, sshd and the controller's key (shared by every target).
COPY tests/integration/target-setup.sh tests/integration/ssh-keys/id_ecdsa.pub /tmp/
RUN bash /tmp/target-setup.sh /tmp/id_ecdsa.pub

# Provision script (scenario-specific config)
ARG SCENARIO=el7-minimal
COPY tests/integration/scenarios/${SCENARIO}/provision.sh /tmp/provision.sh
COPY tests/integration/scenarios/${SCENARIO}/files/ /tmp/provision-files/
RUN chmod +x /tmp/provision.sh && /tmp/provision.sh

# Run sshd in foreground (systemd v219 is incompatible with cgroups v2)
CMD ["/usr/sbin/sshd", "-D"]
